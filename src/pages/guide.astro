---
import Layout from "../layouts/Layout.astro";
import PathsGrid from "../components/PathsGrid.astro";
import GuidesSectionGrid from "../components/GuidesSectionGrid.astro";
import { getCollection } from "astro:content";
import sections from "../content/guides/_sections.json";
// Provide a typed view for the JSON map so TS allows string indexing
const sectionsMap = sections as Record<
  string,
  { order?: number; label?: string }
>;
import { isPlaceholderTodo } from "../utils/guide-filters";

// Load all guides
const entries = await getCollection("guides");

type EntryType = (typeof entries)[number];

// Group by frontmatter category (post-flatten). Fallback to id or slug for sections.
const grouped = entries.reduce(
  (acc, e) => {
    if (e.data.kind === "section") {
      const key = e.data.id || e.slug;
      (acc[key] ||= []).push(e);
    } else {
      const key = e.data.category || "uncategorized";
      (acc[key] ||= []).push(e);
    }
    return acc;
  },
  {} as Record<string, EntryType[]>,
);

for (const key of Object.keys(grouped)) {
  grouped[key].sort(
    (a, b) =>
      (a.data.order ?? 999) - (b.data.order ?? 999) ||
      a.data.title.localeCompare(b.data.title),
  );
}

// Determine which section index pages are placeholder TODO-only
const disabledSectionLinks = new Set<string>();
for (const section of Object.keys(grouped)) {
  const sectionIndex = entries.find(
    (e) =>
      e.data.kind === "section" &&
      (e.data.id === section || e.slug === section),
  );
  if (sectionIndex && isPlaceholderTodo(sectionIndex.body)) {
    disabledSectionLinks.add(section);
  }
}
---

<Layout
  title="Guides - Surf Deeper"
  description="Guides for understanding waves, ocean safety, and surf techniques. Learn from the community."
  fullWidth={true}
>
  <header class="page-header">
    <h1>Guides</h1>
    <p class="page-subtitle">Master the fundamentals and advanced techniques</p>
  </header>

  <!-- Quick access to learning paths -->
  <section class="paths-intro">
    <h2
      class="heading heading-md"
      style="text-align:center; margin: 0 0 var(--space-md) 0;"
    >
      Explore Paths
    </h2>
    <PathsGrid />
  </section>

  <section class="surfing-manual">
    <GuidesSectionGrid
      sectionsMap={sectionsMap}
      grouped={grouped}
      disabledSectionLinks={disabledSectionLinks}
    />
  </section>

  <section class="coming-soon card">
    <h2>Share Your Knowledge</h2>
    <p>
      Have a technique you've mastered? Share it with the community and help
      others improve their surfing.
    </p>
    <a href="/contribute" class="btn btn-primary">Contribute a Technique</a>
  </section>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: var(--space-2xl);
    }

    .page-header h1 {
      color: var(--color-accent);
      font-size: var(--font-size-4xl);
      margin: 0 0 var(--space-sm) 0;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.02em;
    }

    .page-subtitle {
      color: var(--color-text-primary);
      font-size: var(--font-size-xl);
      opacity: 0.9;
      margin: 0;
    }

    .surfing-manual {
      margin: 0 auto;
    }

    .coming-soon {
      text-align: center;
    }

    .coming-soon h2 {
      color: var(--color-accent);
      font-size: var(--font-size-2xl);
      margin: 0 0 var(--space-sm) 0;
    }

    .coming-soon p {
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-sm) 0;
      opacity: 0.9;
    }

    /* button styles are provided by .btn .btn-primary */
  </style>
</Layout>
