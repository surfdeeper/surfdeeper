---
import Layout from "../layouts/Layout.astro";
import PathsGrid from "../components/PathsGrid.astro";
import ConceptsGrid from "../components/ConceptsGrid.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout
  title="Guides - Surf Deeper"
  description="Guides for understanding waves, ocean safety, and surf techniques. Learn from the community."
  fullWidth={true}
>
  <Breadcrumbs items={[{ label: "Guides", ariaCurrent: "page" }]} />
  <header class="page-header">
    <h1>Guides</h1>
    <p class="page-subtitle">Master the fundamentals and advanced techniques</p>
  </header>

  <!-- Paths -->
  <section class="paths-intro">
    <h2 class="heading heading-md section-title">Paths</h2>
    <PathsGrid />
  </section>

  <!-- Concepts -->
  <section class="concepts">
    <h2 class="heading heading-md section-title">Concepts</h2>
    <ConceptsGrid />
  </section>

  <!-- Skills -->
  <section class="skills">
    <h2 class="heading heading-md section-title">Skills</h2>
    <SkillsGrid />
  </section>

  <section class="coming-soon card">
    <h2>Share Your Knowledge</h2>
    <p>
      Have a technique you've mastered? Share it with the community and help
      others improve their surfing.
    </p>
    <a href="/contribute" class="btn btn-primary">Contribute a Technique</a>
  </section>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: var(--space-2xl);
    }

    .page-header h1 {
      color: var(--color-accent);
      font-size: var(--font-size-4xl);
      margin: 0 0 var(--space-sm) 0;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.02em;
    }

    .page-subtitle {
      color: var(--color-text-primary);
      font-size: var(--font-size-xl);
      opacity: 0.9;
      margin: 0;
    }

    .section-title {
      text-align: center;
      margin: 0 0 var(--space-md) 0;
    }

    .coming-soon {
      text-align: center;
    }

    .coming-soon h2 {
      color: var(--color-accent);
      font-size: var(--font-size-2xl);
      margin: 0 0 var(--space-sm) 0;
    }

    .coming-soon p {
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-sm) 0;
      opacity: 0.9;
    }

    /* button styles are provided by .btn .btn-primary */
  </style>
</Layout>
