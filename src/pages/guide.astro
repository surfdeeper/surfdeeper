---
import Layout from "../layouts/Layout.astro";
import PathsGrid from "../components/PathsGrid.astro";
import { getCollection } from "astro:content";

// New model: fetch concepts and skills directly from their collections
const concepts = (await getCollection("concepts")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const skillOrder = new Map([
  ["beginner", 0],
  ["intermediate", 1],
  ["advanced", 2],
]);
const skills = (await getCollection("skills")).sort((a, b) => {
  const aLevel = (a.data as any).skillLevel || (a.data as any).level || "zzz";
  const bLevel = (b.data as any).skillLevel || (b.data as any).level || "zzz";
  const byLevel =
    (skillOrder.get(String(aLevel)) ?? 99) -
    (skillOrder.get(String(bLevel)) ?? 99);
  if (byLevel !== 0) return byLevel;
  return a.data.title.localeCompare(b.data.title);
});

function toTitleCase(s: string | undefined) {
  if (!s) return "";
  return s.charAt(0).toUpperCase() + s.slice(1);
}
---

<Layout
  title="Guides - Surf Deeper"
  description="Guides for understanding waves, ocean safety, and surf techniques. Learn from the community."
  fullWidth={true}
>
  <header class="page-header">
    <h1>Guides</h1>
    <p class="page-subtitle">Master the fundamentals and advanced techniques</p>
  </header>

  <!-- Paths -->
  <section class="paths-intro">
    <h2 class="heading heading-md section-title">Paths</h2>
    <PathsGrid />
  </section>

  <!-- Concepts -->
  <section class="concepts">
    <h2 class="heading heading-md section-title">Concepts</h2>
    {
      concepts.length === 0 ? (
        <p class="empty">No concepts yet.</p>
      ) : (
        <ul class="cards-grid">
          {concepts.map((c) => (
            <li class="card">
              <div class="card-content">
                <h3 class="card-title">
                  <a
                    class="card-link"
                    href={`/guide/${(c.data as any).id || c.slug}`}
                  >
                    {c.data.title}
                  </a>
                </h3>
                {c.data.description && (
                  <p class="card-desc">{c.data.description}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- Skills -->
  <section class="skills">
    <h2 class="heading heading-md section-title">Skills</h2>
    {
      skills.length === 0 ? (
        <p class="empty">No skills yet.</p>
      ) : (
        <ul class="cards-grid">
          {skills.map((s) => {
            const lvl = (s.data as any).skillLevel || (s.data as any).level;
            return (
              <li class="card">
                <div class="card-content">
                  <div class="card-header">
                    <h3 class="card-title">
                      <a
                        class="card-link"
                        href={`/guide/${(s.data as any).id || s.slug}`}
                      >
                        {s.data.title}
                      </a>
                    </h3>
                    {lvl && (
                      <span class="badge">{toTitleCase(String(lvl))}</span>
                    )}
                  </div>
                  {s.data.description && (
                    <p class="card-desc">{s.data.description}</p>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section class="coming-soon card">
    <h2>Share Your Knowledge</h2>
    <p>
      Have a technique you've mastered? Share it with the community and help
      others improve their surfing.
    </p>
    <a href="/contribute" class="btn btn-primary">Contribute a Technique</a>
  </section>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: var(--space-2xl);
    }

    .page-header h1 {
      color: var(--color-accent);
      font-size: var(--font-size-4xl);
      margin: 0 0 var(--space-sm) 0;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.02em;
    }

    .page-subtitle {
      color: var(--color-text-primary);
      font-size: var(--font-size-xl);
      opacity: 0.9;
      margin: 0;
    }

    .section-title {
      text-align: center;
      margin: 0 0 var(--space-md) 0;
    }

    .coming-soon {
      text-align: center;
    }

    .coming-soon h2 {
      color: var(--color-accent);
      font-size: var(--font-size-2xl);
      margin: 0 0 var(--space-sm) 0;
    }

    .coming-soon p {
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-sm) 0;
      opacity: 0.9;
    }

    /* Cards layout reused for Concepts and Skills */
    .cards-grid {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-2xl) 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--space-lg);
    }

    .card-title {
      margin: 0 0 var(--space-2) 0;
      color: var(--color-accent);
      font-size: var(--font-size-lg);
    }

    .card-link {
      color: inherit;
      text-decoration: none;
    }

    .card-link:hover,
    .card-link:focus {
      text-decoration: underline;
    }

    .card-desc {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .badge {
      display: inline-block;
      background: var(--bg-accent-weak);
      color: var(--color-accent);
      border: 1px solid var(--color-border-accent);
      border-radius: var(--radius-sm);
      padding: 0 var(--space-2);
      font-size: var(--font-size-sm);
      white-space: nowrap;
    }

    .empty {
      text-align: center;
      color: var(--color-text-muted);
    }

    /* button styles are provided by .btn .btn-primary */
  </style>
</Layout>
