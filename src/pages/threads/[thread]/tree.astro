---
import Layout from "../../../layouts/Layout.astro";
import {
  buildGraph,
  buildThreadSubgraph,
  computeLayers,
  loadGuides,
} from "../../../utils/knowledge-graph";
import { getCollection } from "astro:content";
import ThreadViewSwitch from "../../../components/threads/ThreadViewSwitch.astro";

export async function getStaticPaths() {
  const [threadsMeta, guides] = await Promise.all([
    getCollection("threads"),
    getCollection("guides"),
  ]);
  const ids = new Set<string>();
  for (const t of threadsMeta) ids.add(t.slug);
  for (const g of guides) for (const t of g.data.threads || []) ids.add(t);
  return Array.from(ids)
    .sort((a, b) => a.localeCompare(b))
    .map((thread) => ({ params: { thread } }));
}

const { params } = Astro;
const entries = await loadGuides();
const graph = buildGraph(entries);
const threadId = params.thread as string;
const threadsMeta = await getCollection("threads");
const threadInfo = threadsMeta.find((t) => t.slug === threadId);
const sub = buildThreadSubgraph(graph, threadId);
const layers = computeLayers(sub);
---

<Layout
  title={`Thread: ${threadInfo?.data.title ?? threadId} – Tree`}
  description={`Dependency tree for ${threadInfo?.data.title ?? threadId} thread.`}
>
  <header class="page-header">
    <h1 class="heading heading-md">
      Thread: {threadInfo?.data.title ?? threadId} (Tree)
    </h1>
    <ThreadViewSwitch threadId={threadId} active="tree" search="" />
  </header>

  {
    layers.length === 0 ? (
      <p>No guides found for this thread.</p>
    ) : (
      <div class="tree">
        {layers.map((layer, i) => (
          <div class="tree-layer">
            <h3 class="layer-title">
              {i === 0 ? "Foundations" : `Layer ${i + 1}`}
            </h3>
            <div class="layer-nodes">
              {layer.map((n) => (
                <a class="node card" href={n.url} title={n.title}>
                  {n.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }

  <style>
    .tree {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .tree-layer {
    }
    .layer-title {
      color: var(--color-accent);
      margin: 0 0 var(--space-sm) 0;
      font-size: var(--font-size-xl);
    }
    .layer-nodes {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
    .node {
      text-decoration: none;
      color: inherit;
    }
    .node:hover {
      border-color: var(--color-border-accent);
    }
  </style>
</Layout>
