---
import Layout from "../../../layouts/Layout.astro";
import {
  buildGraph,
  buildThreadSubgraph,
  loadGuides,
} from "../../../utils/knowledge-graph";
import { getCollection } from "astro:content";
import ThreadViewSwitch from "../../../components/threads/ThreadViewSwitch.astro";

export async function getStaticPaths() {
  const [threadsMeta, guides] = await Promise.all([
    getCollection("threads"),
    getCollection("guides"),
  ]);
  const ids = new Set<string>();
  for (const t of threadsMeta) ids.add(t.slug);
  for (const g of guides) for (const t of g.data.threads || []) ids.add(t);
  return Array.from(ids)
    .sort((a, b) => a.localeCompare(b))
    .map((thread) => ({ params: { thread } }));
}

const { params } = Astro;
const entries = await loadGuides();
const graph = buildGraph(entries);
const threadsMeta = await getCollection("threads");
const threadId = params.thread as string;
const threadInfo = threadsMeta.find((t) => t.slug === threadId);
const level = (Astro.url.searchParams.get("level") || undefined) as
  | "beginner"
  | "intermediate"
  | "advanced"
  | undefined;
const kind = (Astro.url.searchParams.get("kind") || undefined) as
  | "section"
  | "concept"
  | undefined;
const sub = buildThreadSubgraph(graph, threadId, {
  level,
  kind,
});
---

<Layout
  title={`Thread: ${threadInfo?.data.title ?? threadId} – Grid`}
  description={`Guides in the ${threadInfo?.data.title ?? threadId} thread.`}
>
  <header class="page-header">
    <h1 class="heading heading-md">
      Thread: {threadInfo?.data.title ?? threadId}
    </h1>
    <div class="filters">
      <form method="get" class="filters-form">
        <label>
          Level
          <select name="level" class="form-input">
            <option value="">All</option>
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
          </select>
        </label>
        <label>
          Kind
          <select name="kind" class="form-input">
            <option value="">All</option>
            <option value="concept">Concept</option>
            <option value="section">Section</option>
          </select>
        </label>
        <button class="btn btn-secondary" type="submit">Apply</button>
      </form>
      <ThreadViewSwitch
        threadId={threadId}
        active="grid"
        search={Astro.url.search}
      />
    </div>
  </header>

  {
    sub.nodes.length === 0 ? (
      <p>No guides match these filters.</p>
    ) : (
      <section class="cards-grid">
        {sub.nodes.map((n) => (
          <a class="card guide-card" href={n.url}>
            <h3>{n.title}</h3>
            <div class="meta">
              {n.level && <span class="chip">{n.level}</span>}
              {n.kind && <span class="chip">{n.kind}</span>}
            </div>
          </a>
        ))}
      </section>
    )
  }

  <style>
    .page-header {
      margin-bottom: var(--space-lg);
    }
    .filters {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .filters-form {
      display: flex;
      gap: var(--space-4);
      align-items: end;
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: var(--space-lg);
    }
    .guide-card h3 {
      color: var(--color-accent);
      margin: 0 0 var(--space-2) 0;
    }
    .meta {
      display: flex;
      gap: var(--space-2);
    }
    .chip {
      border: 1px solid var(--color-border-accent);
      padding: 0 var(--space-2);
      border-radius: var(--radius-sm);
      font-size: var(--font-size-sm);
      color: var(--color-accent);
      background: var(--bg-accent-weak);
    }
  </style>
</Layout>
