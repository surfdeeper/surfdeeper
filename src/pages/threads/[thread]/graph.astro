---
import Layout from "../../../layouts/Layout.astro";
import {
  buildGraph,
  buildThreadSubgraph,
  loadGuides,
} from "../../../utils/knowledge-graph";
import { getCollection } from "astro:content";
import ThreadViewSwitch from "../../../components/threads/ThreadViewSwitch.astro";

export async function getStaticPaths() {
  const [threadsMeta, guides] = await Promise.all([
    getCollection("threads"),
    getCollection("guides"),
  ]);
  const ids = new Set<string>();
  for (const t of threadsMeta) ids.add(t.slug);
  for (const g of guides) for (const t of g.data.threads || []) ids.add(t);
  return Array.from(ids)
    .sort((a, b) => a.localeCompare(b))
    .map((thread) => ({ params: { thread } }));
}

const { params } = Astro;
const entries = await loadGuides();
const graph = buildGraph(entries);
const threadId = params.thread as string;
const threadsMeta = await getCollection("threads");
const threadInfo = threadsMeta.find((t) => t.slug === threadId);
const sub = buildThreadSubgraph(graph, threadId);
---

<Layout
  title={`Thread: ${threadInfo?.data.title ?? threadId} – 3D Graph`}
  description={`3D graph for ${threadInfo?.data.title ?? threadId} thread.`}
  fullWidth={true}
>
  <header class="page-header">
    <h1 class="heading heading-md">
      Thread: {threadInfo?.data.title ?? threadId} (3D Graph)
    </h1>
    <ThreadViewSwitch threadId={threadId} active="graph" search="" />
  </header>

  <div class="graph-card card">
    <div id="graph-3d" class="graph-container" aria-label="3D knowledge graph">
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    id="graph-data"
    set:html={JSON.stringify({
      nodes: sub.nodes.map((n) => ({
        id: n.id,
        name: n.title,
        level: n.level,
        kind: n.kind,
        url: n.url,
      })),
      links: sub.edges.map((e) => ({
        source: e.source,
        target: e.target,
        type: e.type,
      })),
    })}
  />

  <script is:inline>
    const data = JSON.parse(document.getElementById("graph-data").textContent);
    const container = document.getElementById("graph-3d");
    const style = getComputedStyle(document.documentElement);
    const accent =
      style.getPropertyValue("--color-primary").trim() || "#febc08";

    const init = async () => {
      const [{ default: ForceGraph3D }] = await Promise.all([
        import(
          "https://unpkg.com/3d-force-graph@1.73.4/dist/3d-force-graph.esm.js"
        ),
      ]);

      const Graph = ForceGraph3D()(container)
        .backgroundColor("rgba(0,0,0,0)")
        .graphData(data)
        .nodeLabel("name")
        .nodeAutoColorBy("kind")
        .nodeRelSize(6)
        .linkColor(() => accent)
        .linkOpacity(0.6)
        .onNodeClick((node) => {
          if (node.url) window.location.href = node.url;
        });

      // Fit to container
      Graph.width(container.clientWidth);
      Graph.height(container.clientHeight);
      window.addEventListener("resize", () => {
        Graph.width(container.clientWidth);
        Graph.height(container.clientHeight);
      });
    };
    init();
  </script>

  <style>
    .graph-card {
      height: 70vh;
    }
    .graph-container {
      height: 100%;
      width: 100%;
    }
  </style>
</Layout>
