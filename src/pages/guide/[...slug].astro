---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { isPlaceholderTodo } from "../../utils/guide-filters";
import GuidePathBreadcrumbs from "../../components/GuidePathBreadcrumbs.astro";
// sections are now derived dynamically from content categories

export async function getStaticPaths() {
  // Build paths from typed content and known section slugs
  const concepts = await getCollection("concepts");
  const skills = await getCollection("skills");

  const contentPaths = [...concepts, ...skills].map((e) => ({
    params: { slug: e.slug },
  }));

  // Also include section pages derived from categories present in typed content
  const knownSections = new Set(
    [...concepts, ...skills]
      .map((e) => (e.data as any).category)
      .filter((s): s is string => typeof s === "string" && !!s),
  );
  const sectionPaths = Array.from(knownSections).map((slug) => ({
    params: { slug },
  }));

  return [...contentPaths, ...sectionPaths];
}

const { slug } = Astro.params;
const slugStr = String(slug);

// Load typed collections
const allConcepts = await getCollection("concepts");
const allSkills = await getCollection("skills");
const allTyped = [...allConcepts, ...allSkills];

// Try to find a typed entry by slug
let entry = allTyped.find((e) => e.slug === slugStr);

// If not a typed page, treat as section page if slug matches any category from typed content
const knownSections = new Set(
  allTyped
    .map((e) => (e.data as any).category)
    .filter((s): s is string => typeof s === "string" && !!s),
);
const isSectionPage = !entry && knownSections.has(slugStr);

let Content: any = null;
let data: any = {};
let currentId = "";
let guidePaths: string[] = [];
let sectionGuides: typeof allTyped = [];

// Build an ID -> entry map for graph relationships
const idToEntry = new Map<string, (typeof allTyped)[number]>();
for (const e of allTyped) {
  const id = (e.data as any).id || e.slug;
  if (!idToEntry.has(id)) idToEntry.set(id, e);
}

type RelatedLink = { id: string; title: string; slug: string };
let prerequisites: RelatedLink[] = [];
let leadsTo: RelatedLink[] = [];

if (entry) {
  const rendered = await entry.render();
  Content = rendered.Content;
  data = entry.data;
  currentId = ((entry.data as any).id || entry.slug).trim();
  guidePaths = Array.isArray((entry.data as any).paths)
    ? (entry.data as any).paths
    : [];

  const dependsOnIds = Array.isArray((entry.data as any).dependsOn)
    ? (entry.data as any).dependsOn
    : [];
  const leadsToIds = Array.isArray((entry.data as any).leadsTo)
    ? (entry.data as any).leadsTo
    : [];

  prerequisites = dependsOnIds
    .map((id: string) => idToEntry.get(id))
    .filter(Boolean)
    .map((e: any) => ({
      id: ((e!.data as any).id || e!.slug) as string,
      title: e!.data.title,
      slug: e!.slug,
    }));

  leadsTo = leadsToIds
    .map((id: string) => idToEntry.get(id))
    .filter(Boolean)
    .map((e: any) => ({
      id: ((e!.data as any).id || e!.slug) as string,
      title: e!.data.title,
      slug: e!.slug,
    }));
} else if (isSectionPage) {
  // Section: list typed entries whose category matches this section slug
  sectionGuides = allTyped
    .filter((e) => (e.data as any).category === slugStr)
    .sort(
      (a, b) =>
        ((a.data as any).order ?? 999) - ((b.data as any).order ?? 999) ||
        a.data.title.localeCompare(b.data.title),
    );

  // Fake a minimal section data object for rendering
  data = {
    title:
      slugStr
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ") || slugStr,
    description: undefined,
  };
} else {
  throw Astro.redirect("/guide");
}
---

<Layout
  title={data.title}
  description={data.description}
  editPath={entry
    ? `src/content/${entry.collection as string}/${entry.slug}.md`
    : `src/content/guides/${slugStr}.md`}
>
  <article class="guide-article">
    {Content && <Content />}

    {
      !isSectionPage && (
        <GuidePathBreadcrumbs guideId={currentId} guidePaths={guidePaths} />
      )
    }

    {
      isSectionPage && sectionGuides.length > 0 && (
        <section class="section-guides">
          <h2>Guides in this section</h2>
          <ul class="guides-list">
            {sectionGuides.map((guide) => {
              const disabled = isPlaceholderTodo(guide.body);
              return (
                <li>
                  <a
                    class={disabled ? "is-disabled" : undefined}
                    href={!disabled ? `/guide/${guide.slug}` : "#"}
                    aria-disabled={disabled ? "true" : undefined}
                    tabindex={disabled ? -1 : undefined}
                  >
                    {guide.data.title}
                  </a>
                  {disabled ? (
                    <p class="guide-description">coming soon</p>
                  ) : (
                    guide.data.description && (
                      <p class="guide-description">{guide.data.description}</p>
                    )
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      !isSectionPage && (prerequisites.length > 0 || leadsTo.length > 0) && (
        <section class="graph-links">
          {prerequisites.length > 0 && (
            <div class="graph-block">
              <h2 class="graph-heading">Prerequisites</h2>
              <ul class="graph-list">
                {prerequisites.map((g) => (
                  <li>
                    <a href={`/guide/${g.slug}`}>{g.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {leadsTo.length > 0 && (
            <div class="graph-block">
              <h2 class="graph-heading">Leads to</h2>
              <ul class="graph-list">
                {leadsTo.map((g) => (
                  <li>
                    <a href={`/guide/${g.slug}`}>{g.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }
  </article>

  <style>
    .guide-article {
      max-width: 800px;
      margin: 0 auto;
    }

    .guide-article :global(img) {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto;
    }

    .section-guides {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 2px solid var(--color-border);
    }

    .section-guides h2 {
      color: var(--color-accent);
      font-size: var(--font-size-3xl);
      margin-bottom: var(--space-6);
      text-align: center;
    }

    .guides-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .guides-list li {
      margin-bottom: var(--space-6);
      padding-left: var(--space-6);
      position: relative;
    }

    .guides-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
      font-size: var(--font-size-lg);
    }

    .guides-list li a {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-underline-offset: 3px;
      transition: color var(--transition-base);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
    }

    .guides-list li a:hover {
      color: var(--color-accent-hover);
      text-decoration-color: var(--color-accent);
    }

    .guides-list li a.is-disabled {
      pointer-events: none;
      opacity: 0.6;
      text-decoration: none;
      cursor: default;
    }

    .guide-description {
      color: var(--color-text-primary);
      opacity: 0.9;
      margin: var(--space-2) 0 0 0;
      line-height: var(--line-height-relaxed);
      font-size: var(--font-size-sm);
    }

    /* Knowledge graph related links */
    .graph-links {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 2px solid var(--color-border);
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .graph-heading {
      color: var(--color-accent);
      font-size: var(--font-size-2xl);
      margin: 0 0 var(--space-4) 0;
      text-align: center;
    }

    .graph-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .graph-list li {
      margin-bottom: var(--space-3);
      padding-left: var(--space-6);
      position: relative;
    }

    .graph-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
      font-size: var(--font-size-lg);
    }

    @media (min-width: 768px) {
      .graph-links {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* Breadcrumb styles live in GuidePathBreadcrumbs component */
  </style>
</Layout>
