---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  // Keep legacy links to /guide/:slug working by prebuilding guide slugs
  const concepts = await getCollection("concepts");
  const skills = await getCollection("skills");
  return [...concepts, ...skills].map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const slugStr = String(slug || "");
const concepts = await getCollection("concepts");
const skills = await getCollection("skills");
const isConcept = concepts.some((e) => e.slug === slugStr);
const isSkill = skills.some((e) => e.slug === slugStr);

// Redirect to the appropriate typed route, else back to /guide
if (isSkill) return Astro.redirect(`/skill/${slugStr}`);
if (isConcept) return Astro.redirect(`/concept/${slugStr}`);
return Astro.redirect("/guide");
---
