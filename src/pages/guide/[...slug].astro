---
import Layout from "../../layouts/Layout.astro";
import {
  getCollection,
  getEntryBySlug,
  type CollectionEntry,
} from "astro:content";
import { isPlaceholderTodo } from "../../utils/guide-filters";
import GuidePathBreadcrumbs from "../../components/GuidePathBreadcrumbs.astro";

export async function getStaticPaths() {
  const entries = await getCollection("guides");
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const slugStr = String(slug);
let entry = await getEntryBySlug("guides", slugStr);

// If direct slug not found, try section/index pattern
if (!entry && !slugStr.includes("/")) {
  entry = await getEntryBySlug("guides", `${slugStr}/index`);
}

if (!entry) {
  throw Astro.redirect("/guide");
}

const { Content } = await entry.render();
const { data } = entry;

// Common identifiers used across render
const currentId = (entry.data.id || entry.slug).trim();
const guidePaths: string[] = Array.isArray(entry.data.paths)
  ? entry.data.paths
  : [];

// Determine section vs concept using frontmatter (post-flatten)
const isSectionPage = entry.data.kind === "section";
let sectionGuides: any[] = [];

// Build an ID -> entry map for graph relationships
const allGuides = await getCollection("guides");
const idToEntry = new Map<string, (typeof allGuides)[number]>();
for (const e of allGuides) {
  const id = (e.data.id || e.slug).trim();
  if (!idToEntry.has(id)) idToEntry.set(id, e);
}

type RelatedLink = { id: string; title: string; slug: string };
let prerequisites: RelatedLink[] = [];
let leadsTo: RelatedLink[] = [];

// Path breadcrumbs are rendered by GuidePathBreadcrumbs component

if (isSectionPage) {
  // Get all guides with matching category, excluding section files
  const sectionId = entry.data.id || entry.slug;
  sectionGuides = allGuides
    .filter(
      (guide) =>
        guide.data.kind !== "section" && guide.data.category === sectionId,
    )
    .sort(
      (a, b) =>
        (a.data.order ?? 999) - (b.data.order ?? 999) ||
        a.data.title.localeCompare(b.data.title),
    );
} else {
  // Concept page: resolve dependsOn and leadsTo graph links by ID
  const dependsOnIds = Array.isArray(entry.data.dependsOn)
    ? entry.data.dependsOn
    : [];
  const leadsToIds = Array.isArray(entry.data.leadsTo)
    ? entry.data.leadsTo
    : [];

  prerequisites = dependsOnIds
    .map((id) => idToEntry.get(id))
    .filter(Boolean)
    .map((e) => ({
      id: e!.data.id || e!.slug,
      title: e!.data.title,
      slug: e!.slug,
    }));

  leadsTo = leadsToIds
    .map((id) => idToEntry.get(id))
    .filter(Boolean)
    .map((e) => ({
      id: e!.data.id || e!.slug,
      title: e!.data.title,
      slug: e!.slug,
    }));

  // Nothing additional; breadcrumb props are computed above
}
---

<Layout
  title={data.title}
  description={data.description}
  editPath={`src/content/guides/${entry.slug}.md`}
>
  <article class="guide-article">
    <Content />

    {
      !isSectionPage && (
        <GuidePathBreadcrumbs guideId={currentId} guidePaths={guidePaths} />
      )
    }

    {
      isSectionPage && sectionGuides.length > 0 && (
        <section class="section-guides">
          <h2>Guides in this section</h2>
          <ul class="guides-list">
            {sectionGuides.map((guide) => {
              const disabled = isPlaceholderTodo(guide.body);
              return (
                <li>
                  <a
                    class={disabled ? "is-disabled" : undefined}
                    href={!disabled ? `/guide/${guide.slug}` : "#"}
                    aria-disabled={disabled ? "true" : undefined}
                    tabindex={disabled ? -1 : undefined}
                  >
                    {guide.data.title}
                  </a>
                  {disabled ? (
                    <p class="guide-description">coming soon</p>
                  ) : (
                    guide.data.description && (
                      <p class="guide-description">{guide.data.description}</p>
                    )
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      !isSectionPage && (prerequisites.length > 0 || leadsTo.length > 0) && (
        <section class="graph-links">
          {prerequisites.length > 0 && (
            <div class="graph-block">
              <h2 class="graph-heading">Prerequisites</h2>
              <ul class="graph-list">
                {prerequisites.map((g) => (
                  <li>
                    <a href={`/guide/${g.slug}`}>{g.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {leadsTo.length > 0 && (
            <div class="graph-block">
              <h2 class="graph-heading">Leads to</h2>
              <ul class="graph-list">
                {leadsTo.map((g) => (
                  <li>
                    <a href={`/guide/${g.slug}`}>{g.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }
  </article>

  <style>
    .guide-article {
      max-width: 800px;
      margin: 0 auto;
    }

    .guide-article :global(img) {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto;
    }

    .section-guides {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 2px solid var(--color-border);
    }

    .section-guides h2 {
      color: var(--color-accent);
      font-size: var(--font-size-3xl);
      margin-bottom: var(--space-6);
      text-align: center;
    }

    .guides-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .guides-list li {
      margin-bottom: var(--space-6);
      padding-left: var(--space-6);
      position: relative;
    }

    .guides-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
      font-size: var(--font-size-lg);
    }

    .guides-list li a {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-underline-offset: 3px;
      transition: color var(--transition-base);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
    }

    .guides-list li a:hover {
      color: var(--color-accent-hover);
      text-decoration-color: var(--color-accent);
    }

    .guides-list li a.is-disabled {
      pointer-events: none;
      opacity: 0.6;
      text-decoration: none;
      cursor: default;
    }

    .guide-description {
      color: var(--color-text-primary);
      opacity: 0.9;
      margin: var(--space-2) 0 0 0;
      line-height: var(--line-height-relaxed);
      font-size: var(--font-size-sm);
    }

    /* Knowledge graph related links */
    .graph-links {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 2px solid var(--color-border);
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .graph-heading {
      color: var(--color-accent);
      font-size: var(--font-size-2xl);
      margin: 0 0 var(--space-4) 0;
      text-align: center;
    }

    .graph-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .graph-list li {
      margin-bottom: var(--space-3);
      padding-left: var(--space-6);
      position: relative;
    }

    .graph-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
      font-size: var(--font-size-lg);
    }

    @media (min-width: 768px) {
      .graph-links {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* Breadcrumb styles live in GuidePathBreadcrumbs component */
  </style>
</Layout>
