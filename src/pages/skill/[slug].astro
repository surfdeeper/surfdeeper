---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GuideDetailLayout from "../../components/GuideDetailLayout.astro";
import SidebarPathSummary from "../../components/SidebarPathSummary.astro";
import SidebarGraphSummary from "../../components/SidebarGraphSummary.astro";

export async function getStaticPaths() {
  const entries = await getCollection("skills");
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params as { slug: string };
const skills = (await getCollection("skills")) as CollectionEntry<"skills">[];
const entry = skills.find((e) => e.slug === slug);

if (!entry) throw Astro.redirect("/skill");

const rendered = await entry.render();
const Content = rendered.Content;
const data = entry.data as any;

// For path breadcrumbs
const currentId = ((data.id || entry.slug) as string).trim();
const guidePaths: string[] = Array.isArray(data.paths) ? data.paths : [];

// Delegate related graph link computation to the GraphLinks component
---

<Layout
  title={`${data.title} – Skill – SurfDeeper`}
  description={data.description}
  editPath={`src/content/skills/${entry.slug}.md`}
>
  <Breadcrumbs
    items={[
      { href: "/guide", label: "Guides" },
      { href: "/skill", label: "Skills" },
      { label: data.title, ariaCurrent: "page" },
    ]}
  />

  <GuideDetailLayout>
    <div slot="sidebar" class="sidebar-stack">
      {
        guidePaths.length > 0 && (
          <SidebarPathSummary guideId={currentId} guidePaths={guidePaths} />
        )
      }
      <SidebarGraphSummary
        currentId={currentId}
        slug={entry.slug}
        dependsOnIds={data.dependsOn}
        leadsToIds={data.leadsTo}
      />
    </div>

    <article class="guide-article">
      <Content />
    </article>
  </GuideDetailLayout>

  <style>
    .guide-article {
      max-width: none;
    }
    .sidebar-stack {
      display: grid;
      gap: var(--space-4);
    }
  </style>
</Layout>
