---
import FixtureLayout from "./_FixtureLayout.astro";
import LeftSidebar from "../../components/sidebar/LeftSidebar.astro";
import sections from "../../content/guides/_sections.json";

// Build minimal props: 3 guides per section
const guidesBySection: Record<
  string,
  Array<{ title: string; url: string }>
> = {};
const comingSoonCountBySection: Record<string, number> = {};

for (const [slug, section] of Object.entries(
  sections as Record<string, { label: string; order: number }>,
)) {
  guidesBySection[slug] = [
    { title: section.label, url: `/guide#${slug}` },
    { title: `${section.label} A`, url: `/guide/${slug}/a` },
    { title: `${section.label} B`, url: `/guide/${slug}/b` },
    { title: `${section.label} C`, url: `/guide/${slug}/c` },
  ];
  comingSoonCountBySection[slug] = 2;
}
---

<FixtureLayout title="Left Sidebar Fixture">
  <div data-testid="fixture-root" style="display:block;">
    <LeftSidebar {guidesBySection} {comingSoonCountBySection} />
  </div>
  <style>
    /* Ensure sidebar is visible regardless of viewport breakpoint */
    :global(.left-sidebar) {
      display: block !important;
      max-width: 320px;
    }
  </style>
</FixtureLayout>
