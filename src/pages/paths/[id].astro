---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PathSidebar from "../../components/PathSidebar.astro";

export async function getStaticPaths() {
  const paths: CollectionEntry<"paths">[] = await getCollection("paths");
  return paths.map((t: CollectionEntry<"paths">) => ({
    params: { id: t.slug },
  }));
}

const { id } = Astro.params as { id: string };

const pathMeta: CollectionEntry<"paths">[] = await getCollection("paths");
const meta = pathMeta.find((t: CollectionEntry<"paths">) => t.slug === id);

const title = meta?.data.title || id;
const description = meta?.data.description || "";
const icon = meta?.data.icon || "";
const nodes = (meta?.data as any)?.nodes || [];
let Content: any = null;
if (meta) {
  const rendered = await meta.render();
  Content = rendered.Content;
}

// Note: Inline link numbering is handled by the remark plugin (scripts/remark-learning-links.mjs)
---

<Layout
  title={`${title} – Paths – SurfDeeper`}
  description={description}
  fullWidth
>
  <Breadcrumbs
    items={[
      { href: "/guide", label: "Guides" },
      { href: "/paths", label: "Paths" },
      { label: title, ariaCurrent: "page" },
    ]}
  />
  <header class="page-header">
    <h1 class="heading heading-lg">
      {
        icon && (
          <span class="icon" aria-hidden="true">
            {icon}
          </span>
        )
      }
      <span class="sr-only">Path:</span>
      {title}
    </h1>
    {description && <p class="page-subtitle">{description}</p>}
  </header>

  <div class="content-wrap">
    <div class="sidebar-col" role="complementary">
      <PathSidebar pathId={id} nodes={nodes} title="On this path" />
    </div>
    <div class="main-col" role="main">
      {
        Content ? (
          <article class="thread-body">
            <Content />
          </article>
        ) : (
          <p class="empty">This path doesn't have content yet.</p>
        )
      }
    </div>
  </div>

  <style>
    :global(main.full-width) {
      max-width: 1400px;
    }

    .page-header {
      text-align: center;
      margin-bottom: var(--space-2xl);
    }

    .heading {
      color: var(--color-accent);
      margin: 0 0 var(--space-sm) 0;
      font-weight: var(--font-weight-bold);
    }

    .icon {
      margin-right: var(--space-2);
      font-size: var(--font-size-2xl);
    }

    .page-subtitle {
      font-size: var(--font-size-lg);
      opacity: 0.9;
      margin: 0;
      color: var(--color-text-muted);
    }

    .empty {
      color: var(--color-text-muted);
      font-size: var(--font-size-md);
      text-align: center;
    }

    .content-wrap {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
      align-items: start;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 var(--space-md);
    }

    .sidebar-col {
      order: 2;
    }
    .main-col {
      order: 1;
    }

    @media (min-width: 1200px) {
      .content-wrap {
        grid-template-columns: minmax(240px, 320px) 1fr;
      }
      .sidebar-col {
        order: 1;
      }
      .main-col {
        order: 2;
      }
    }

    .thread-body {
      max-width: none;
      margin: 0;
      line-height: 1.7;
    }

    /* Enhanced typography for path content */
    .thread-body :global(h2) {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-accent);
      margin-top: var(--space-2xl);
      margin-bottom: var(--space-md);
      border-bottom: 2px solid var(--color-border);
      padding-bottom: var(--space-2);
    }

    .thread-body :global(h3) {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text);
      margin-top: var(--space-xl);
      margin-bottom: var(--space-sm);
    }

    .thread-body :global(h4) {
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-muted);
      margin-top: var(--space-lg);
      margin-bottom: var(--space-sm);
    }

    .thread-body :global(p) {
      margin-bottom: var(--space-md);
    }

    .thread-body :global(ul),
    .thread-body :global(ol) {
      margin-bottom: var(--space-md);
      padding-left: var(--space-xl);
    }

    .thread-body :global(li) {
      margin-bottom: var(--space-2);
    }

    .thread-body :global(blockquote) {
      border-left: 4px solid var(--color-accent);
      padding-left: var(--space-md);
      margin: var(--space-lg) 0;
      font-style: italic;
      color: var(--color-text-muted);
    }

    .thread-body :global(code) {
      background: var(--color-surface-raised);
      padding: var(--space-1) var(--space-2);
      border-radius: 4px;
      font-size: var(--font-size-sm);
    }

    .thread-body :global(pre) {
      background: var(--color-surface-raised);
      padding: var(--space-md);
      border-radius: 8px;
      overflow-x: auto;
      margin-bottom: var(--space-md);
    }

    .thread-body :global(pre code) {
      background: none;
      padding: 0;
    }

    /* Learning link styles */
    .thread-body :global(.learning-link) {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: var(--font-weight-semibold);
      border-bottom: 2px solid var(--color-accent-transparent);
      padding-bottom: 2px;
      transition: border-color 0.2s;
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-2);
    }

    .thread-body :global(.learning-link:hover) {
      border-bottom-color: var(--color-accent);
    }

    /* Disabled behavior now handled by global .is-disabled and .u-coming-soon */

    /* SSR number badge to correlate with sidebar order */
    .thread-body :global(.learning-link[data-number])::before {
      content: attr(data-number);
      display: inline-block;
      font-variant-numeric: tabular-nums;
      color: var(--color-accent);
      background: var(--color-surface-raised);
      border: 1px solid var(--color-accent-transparent);
      border-radius: 6px;
      padding: 0 var(--space-2);
      line-height: 1.6;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      margin-right: var(--space-2);
    }

    .thread-body :global(.broken-learning-link) {
      color: var(--color-error);
      text-decoration: line-through;
      font-weight: var(--font-weight-semibold);
    }
  </style>
</Layout>
