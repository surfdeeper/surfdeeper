---
import { getCollection } from "astro:content";
import sections from "../../../content/guides/_sections.json";
import { unified } from "unified";
import remarkParse from "remark-parse";
import remarkGfm from "remark-gfm";
import { visit } from "unist-util-visit";

interface GalleryImage {
  src: string;
  alt: string;
  caption: string;
  guideTitle: string;
  guideLink: string;
  section: string;
  context?: string;
}

// Build a lightweight gallery index from guides content
const allGuides = await getCollection("guides");
const images: GalleryImage[] = [];

for (const guide of allGuides) {
  // Skip index pages
  if (guide.slug.endsWith("/index") || !guide.slug.includes("/")) continue;

  const guideLink = `/guide/${guide.slug}`;
  const guideTitle = guide.data.title;
  const sectionSlug = guide.slug.split("/")[0];
  const sectionData = sections[sectionSlug as keyof typeof sections];
  const sectionLabel = sectionData?.label || sectionSlug;

  const body = guide.body;

  // Parse markdown body to extract images and nearby heading context
  const tree = unified().use(remarkParse).use(remarkGfm).parse(body);

  // Collect heading nodes with their starting line and text
  const headings: { text: string; line: number }[] = [];
  visit(tree, "heading", (node: any) => {
    const text = extractText(node).trim();
    const line = node?.position?.start?.line || 1;
    if (text) headings.push({ text, line });
  });
  // Sort headings by line just in case
  headings.sort((a, b) => a.line - b.line);

  // Gather definitions to resolve reference-style images
  const definitions = new Map<string, string>();
  visit(tree, "definition", (node: any) => {
    const id = String(node.identifier || "").toLowerCase();
    if (id && typeof node.url === "string") {
      definitions.set(id, node.url);
    }
  });

  // Helper to add an image with context
  const addImage = (
    src: string | undefined,
    alt: string | undefined,
    node: any,
  ) => {
    if (!src) return;
    const imageLine = node?.position?.start?.line || 1;
    // Find closest previous heading by line
    let closestHeading: string | undefined;
    for (let i = headings.length - 1; i >= 0; i--) {
      if (headings[i].line < imageLine) {
        closestHeading = headings[i].text;
        break;
      }
    }
    const caption = (alt && alt.trim()) || guideTitle;
    images.push({
      src,
      alt: (alt && alt.trim()) || guideTitle,
      caption,
      guideTitle,
      guideLink,
      section: sectionLabel,
      context: closestHeading,
    });
  };

  // Inline images: ![alt](url)
  visit(tree, "image", (node: any) => {
    addImage(node.url, node.alt || "", node);
  });

  // Reference-style images: ![alt][id]
  visit(tree, "imageReference", (node: any) => {
    const id = String(node.identifier || "").toLowerCase();
    const url = definitions.get(id);
    addImage(url, node.alt || "", node);
  });

  // Helper to extract concatenated text from a mdast node
  function extractText(node: any): string {
    let text = "";
    visit(node, "text", (t: any) => {
      text += t.value || "";
    });
    return text;
  }
}

// Pick a random image (build-time randomness)
const randomImage = images.length
  ? images[Math.floor(Math.random() * images.length)]
  : null;
---

{
  randomImage && (
    <div class="card gallery-widget">
      <h3>🎴 From the Gallery</h3>
      <a
        href={randomImage.guideLink}
        class="preview-link"
        aria-label={`Open guide: ${randomImage.guideTitle}`}
      >
        <img
          src={randomImage.src}
          alt={randomImage.alt}
          loading="lazy"
          class="preview-image"
        />
        <div class="caption">
          {randomImage.context && (
            <div class="context">{randomImage.context}</div>
          )}
          <div class="title">{randomImage.caption}</div>
          <div class="meta">from: {randomImage.guideTitle}</div>
        </div>
      </a>
      <div class="cta">
        <a href="/gallery" class="btn btn-secondary">
          See all →
        </a>
      </div>
    </div>
  )
}

{
  !randomImage && (
    <div class="card gallery-widget">
      <h3>🎴 From the Gallery</h3>
      <p class="empty">
        No images found yet. <a href="/contribute">Contribute</a> some visuals!
      </p>
    </div>
  )
}

<style>
  .gallery-widget h3 {
    color: var(--color-accent);
    font-size: var(--font-size-xl);
    margin: 0 0 var(--space-sm) 0;
    font-weight: var(--font-weight-semibold);
  }

  .preview-link {
    display: block;
    text-decoration: none;
  }

  .preview-image {
    width: 100%;
    height: 180px;
    object-fit: contain;
    display: block;
    background-color: var(--color-surface-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: var(--space-sm);
  }

  .caption {
    margin-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .context {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    opacity: 0.7;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .title {
    color: var(--color-accent);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }

  .meta {
    color: var(--color-text-secondary);
    opacity: 0.8;
    font-size: var(--font-size-sm);
    font-style: italic;
  }

  .cta {
    margin-top: var(--space-md);
    display: flex;
    justify-content: flex-end;
  }

  .empty {
    color: var(--color-text-secondary);
    opacity: 0.9;
    font-size: var(--font-size-sm);
    margin: 0;
  }
</style>
