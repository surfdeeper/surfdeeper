---
import { getCollection } from "astro:content";
import {
  loadGuides,
  buildGraph,
  buildPathSubgraph,
} from "../utils/knowledge-graph";
import { computePathCrumbs } from "./guide-path-breadcrumbs.util";

export interface Props {
  guideId: string; // entry.data.id || entry.slug
  guidePaths: string[]; // entry.data.paths
}

const { guideId, guidePaths } = Astro.props as Props;

let pathCrumbs: ReturnType<typeof computePathCrumbs> = [] as any;

if (guidePaths && guidePaths.length > 0) {
  const [allGuides, pathsMeta] = await Promise.all([
    loadGuides(),
    getCollection("paths" as const),
  ]);
  const graph = buildGraph(allGuides);
  const metaById = new Map<string, { title: string; icon?: string }>();
  for (const p of pathsMeta)
    metaById.set(p.slug, { title: p.data.title, icon: p.data.icon });
  pathCrumbs = computePathCrumbs(
    guideId,
    guidePaths,
    (pathId) => buildPathSubgraph(graph, pathId, { kind: "concept" }),
    metaById,
  );
}
---

{
  pathCrumbs.length > 0 && (
    <section class="path-breadcrumbs">
      {pathCrumbs.map((p) => (
        <div class="path-row">
          <div class="path-meta">
            <a class="path-title" href={`/paths/${p.id}`}>
              {p.icon && (
                <span class="path-icon" aria-hidden="true">
                  {p.icon}
                </span>
              )}
              {p.title}
            </a>
          </div>
          <nav class="crumbs" aria-label={`Path progression: ${p.title}`}>
            {p.sequence.map((s, idx) => (
              <span class={`crumb${s.isCurrent ? " is-current" : ""}`}>
                <a href={s.url} aria-current={s.isCurrent ? "page" : undefined}>
                  {s.title}
                </a>
                {idx < p.sequence.length - 1 && (
                  <span class="sep" aria-hidden="true">
                    →
                  </span>
                )}
              </span>
            ))}
          </nav>
        </div>
      ))}
    </section>
  )
}

<style>
  .path-breadcrumbs {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 2px solid var(--color-border);
    display: grid;
    gap: var(--space-6);
  }

  .path-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .path-meta {
    text-align: center;
  }

  .path-title {
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .path-title:hover {
    text-decoration: underline;
  }

  .path-icon {
    margin-right: var(--space-2);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    line-height: 1.6;
  }

  .crumb a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 1px;
  }

  .crumb a:hover {
    border-bottom-color: var(--color-border);
  }

  .crumb.is-current a {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
    border-bottom-color: var(--color-accent-transparent);
  }

  .sep {
    margin: 0 var(--space-1);
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .path-row {
      grid-template-columns: 220px 1fr;
    }
    .path-meta {
      text-align: right;
      padding-right: var(--space-3);
    }
    .crumbs {
      justify-content: flex-start;
    }
  }
</style>
