---
// Navigation component - single source of truth for main navigation
import { Image } from "astro:assets";
import logoV2 from "../assets/logo-v2.png";
import favicon from "../assets/favicon.svg";
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label="Surf Deeper home">
      <span class="logo-crop">
        <Image
          src={logoV2}
          alt="SurfDeeper logo"
          class="image-logo"
          width={180}
          height={108}
          loading="eager"
          format="webp"
          quality={85}
        />
      </span>
    </a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/guide">Guide</a></li>
      <li><a href="/paths">Paths</a></li>
      <li><a href="/maps">Map</a></li>
      <li><a href="/contribute">Contribute</a></li>
      <li><a href="/gallery">Gallery</a></li>
    </ul>
  </div>
</nav>

<style>
  /* Logo-specific styles */
  .logo-crop {
    display: block;
    height: auto;
    overflow: visible;
    line-height: 0;
  }

  .image-logo {
    max-height: 200px;
    height: auto;
    width: auto;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  /* Responsive logo sizing */
  @media (max-width: 768px) {
    .image-logo {
      max-height: 120px;
    }
  }
</style>
