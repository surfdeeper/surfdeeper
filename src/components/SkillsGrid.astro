---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  /** Optional limit for number of skills to show */
  limit?: number;
}

const { limit } = Astro.props as Props;

function toTitleCase(s?: string) {
  if (!s) return "";
  return s.charAt(0).toUpperCase() + s.slice(1);
}

const skillOrder = new Map([
  ["beginner", 0],
  ["intermediate", 1],
  ["advanced", 2],
]);

// Data
const allSkills = (await getCollection(
  "skills",
)) as CollectionEntry<"skills">[];
const sorted = allSkills.sort((a, b) => {
  const aLevel = (a.data as any).skillLevel || (a.data as any).level || "zzz";
  const bLevel = (b.data as any).skillLevel || (b.data as any).level || "zzz";
  const byLevel =
    (skillOrder.get(String(aLevel)) ?? 99) -
    (skillOrder.get(String(bLevel)) ?? 99);
  if (byLevel !== 0) return byLevel;
  return a.data.title.localeCompare(b.data.title);
});
const skills = typeof limit === "number" ? sorted.slice(0, limit) : sorted;
---

{
  skills.length === 0 ? (
    <p class="empty">No skills yet.</p>
  ) : (
    <ul class="cards-grid">
      {skills.map((s) => {
        const lvl = (s.data as any).skillLevel || (s.data as any).level;
        return (
          <li class="card">
            <div class="card-content">
              <div class="card-header">
                <h3 class="card-title">
                  <a
                    class="card-link"
                    href={`/guide/${(s.data as any).id || s.slug}`}
                  >
                    {s.data.title}
                  </a>
                </h3>
                {lvl && <span class="badge">{toTitleCase(String(lvl))}</span>}
              </div>
              {s.data.description && (
                <p class="card-desc">{s.data.description}</p>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .cards-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2xl) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .card-title {
    margin: 0 0 var(--space-2) 0;
    color: var(--color-accent);
    font-size: var(--font-size-lg);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover,
  .card-link:focus {
    text-decoration: underline;
  }

  .card-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .badge {
    display: inline-block;
    background: var(--bg-accent-weak);
    color: var(--color-accent);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
