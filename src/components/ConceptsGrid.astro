---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  /** If true, shows a footer link to the Concepts section on the Guides page */
  showFooterLink?: boolean;
  /** Optional limit for number of concepts to show */
  limit?: number;
}

const { showFooterLink = false, limit } = Astro.props as Props;

// Data
const allConcepts = (await getCollection(
  "concepts",
)) as CollectionEntry<"concepts">[];
const sorted = allConcepts.sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const concepts = typeof limit === "number" ? sorted.slice(0, limit) : sorted;
---

{
  concepts.length === 0 ? (
    <p class="empty">No concepts yet.</p>
  ) : (
    <>
      <ul class="cards-grid">
        {concepts.map((c) => (
          <li class="card">
            <div class="card-content">
              <h3 class="card-title">
                <a
                  class="card-link"
                  href={`/guide/${(c.data as any).id || c.slug}`}
                >
                  {c.data.title}
                </a>
              </h3>
              {c.data.description && (
                <p class="card-desc">{c.data.description}</p>
              )}
            </div>
          </li>
        ))}
      </ul>

      {showFooterLink && (
        <footer class="concepts-footer">
          <a class="concepts-footer-link" href="/guide#concepts">
            View all concepts →
          </a>
        </footer>
      )}
    </>
  )
}

<style>
  .cards-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2xl) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .card-title {
    margin: 0 0 var(--space-2) 0;
    color: var(--color-accent);
    font-size: var(--font-size-lg);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover,
  .card-link:focus {
    text-decoration: underline;
  }

  .card-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }

  .concepts-footer {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
  }

  .concepts-footer-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .concepts-footer-link:hover,
  .concepts-footer-link:focus {
    text-decoration: underline;
  }
</style>
