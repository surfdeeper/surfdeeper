---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  /** If true, shows a footer link to the Concepts section on the Guides page */
  showFooterLink?: boolean;
  /** Optional limit for number of concepts to show */
  limit?: number;
}

const { showFooterLink = false, limit } = Astro.props as Props;

// Data
const allConcepts = (await getCollection(
  "concepts",
)) as CollectionEntry<"concepts">[];
const sorted = allConcepts.sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const concepts = typeof limit === "number" ? sorted.slice(0, limit) : sorted;
---

{
  concepts.length === 0 ? (
    <p class="empty">No concepts yet.</p>
  ) : (
    <>
      <ul class="grid-cards links-inherit">
        {concepts.map((c) => (
          <li class="card">
            <div class="card-content">
              <h3 class="card-title heading heading-sm">
                <a
                  class="card-link"
                  href={`/guide/${(c.data as any).id || c.slug}`}
                >
                  {c.data.title}
                </a>
              </h3>
              {c.data.description && (
                <p class="card-desc text-sm text-secondary">
                  {c.data.description}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>

      {showFooterLink && (
        <footer class="centered-footer">
          <a class="concepts-footer-link" href="/guide#concepts">
            View all concepts →
          </a>
        </footer>
      )}
    </>
  )
}

<style>
  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }

  .concepts-footer-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .concepts-footer-link:hover,
  .concepts-footer-link:focus {
    text-decoration: underline;
  }
</style>
