---
import { buildGraph, getPaths, loadGuides } from "../utils/knowledge-graph";
import { getOrderedPathItems } from "../utils/path-helpers";
import { getCollection, type CollectionEntry } from "astro:content";

// Props
interface Props {}
const {} = Astro.props as Props;

// Data
const entries = await loadGuides();
const graph = buildGraph(entries);
const pathIds = getPaths(graph);
const pathMeta: CollectionEntry<"paths">[] = await getCollection("paths");
const paths = pathIds.map((id) => {
  const meta = pathMeta.find((t: CollectionEntry<"paths">) => t.slug === id);
  return {
    id,
    title: meta?.data.title || id,
    description: meta?.data.description || "",
  };
});
---

{
  paths.length === 0 ? (
    <p>No paths tagged yet. Add paths to guides' frontmatter (paths: []).</p>
  ) : (
    <>
      <section class="grid-tiles">
        {await Promise.all(
          paths.map(async (t) => {
            const items = await getOrderedPathItems(graph, t.id);
            return (
              <article class="card stretched-parent">
                <a
                  class="stretched-link"
                  href={`/paths/${t.id}`}
                  aria-label={`Open path ${t.title}`}
                />
                <div class="thread-card-header stretched-content">
                  <div>
                    <h2 class="heading heading-sm">
                      <a class="thread-link" href={`/paths/${t.id}`}>
                        {t.title}
                      </a>
                    </h2>
                    {t.description && (
                      <p class="thread-desc">{t.description}</p>
                    )}
                  </div>
                  <span class="badge">{items.length}</span>
                </div>
                <ul class="preview links-neutral stretched-content">
                  {items.slice(0, 4).map((n) => {
                    const disabled = n.isPlaceholder === true;
                    return (
                      <li>
                        <a
                          class={disabled ? "is-disabled" : undefined}
                          href={disabled ? "#" : n.url}
                          aria-disabled={disabled ? "true" : undefined}
                          tabindex={disabled ? -1 : undefined}
                        >
                          <span class="num">{n.number}</span>
                          <span class="label">{n.title}</span>
                        </a>
                        {disabled && <span class="soon"> — coming soon</span>}
                      </li>
                    );
                  })}
                  {items.length > 4 && (
                    <li class="more">+{items.length - 4} more</li>
                  )}
                </ul>
              </article>
            );
          }),
        )}
      </section>
    </>
  )
}

<style>
  .thread-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .thread-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .thread-link {
    color: inherit;
    text-decoration: none;
  }

  .thread-link:hover,
  .thread-link:focus {
    text-decoration: underline;
  }

  .preview {
    margin: 0 0 var(--space-md) 0;
  }

  .preview li {
    margin-bottom: var(--space-2);
  }

  .preview .more {
    color: var(--color-accent);
  }

  .preview a.is-disabled {
    pointer-events: none;
    opacity: 0.6;
    text-decoration: none;
    cursor: default;
  }
  .preview a .num {
    display: inline-block;
    min-width: 2ch;
    margin-right: var(--space-2);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }
  .preview a .label {
    color: inherit;
  }
  .preview .soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* footer link removed */
</style>
