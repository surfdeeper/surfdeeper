{
  // Enable defaults, then override conflicting rules for our style
  "default": true,

  // Long lines are OK because Prettier is configured with proseWrap: "never"
  "MD013": false,

  // Allow some inline HTML we commonly use
  "MD033": {
    "allowed_elements": ["br", "details", "summary", "kbd", "sup", "sub"],
  },

  // Support title coming from frontmatter and keep level at 1 when present
  "MD041": {
    "level": 1,
    "front_matter_title": "title",
  },

  // Avoid false positives when frontmatter provides the title
  "MD025": false,

  // Consistent list indentation / numbering style
  "MD007": { "indent": 2 },
  "MD029": { "style": "ordered" },

  // Avoid duplicate heading complaints when nesting differs
  "MD024": { "allow_different_nesting": true },
}
