{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "types": ["astro/client", "node", "@playwright/test"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".astro",
    "surfdeeper3",
    "tests/**/*.test.*",
    "tests/**/*.spec.*",
    "vitest.config.ts"
  ]
}
